# Copy to .env on the server and fill in real values. Never commit .env.
# Lines marked REQUIRED must be set or the app refuses to start.

# --- Public address (REQUIRED) ---
# Domain pointing at this server; Caddy gets the HTTPS certificate for it automatically.
DOMAIN=assistant.example.com

# --- Meta WhatsApp Cloud API (REQUIRED) ---
# From developers.facebook.com > your app > WhatsApp > API Setup (token, phone number ID)
# and App settings > Basic (app secret). The verify token is any random text you choose;
# type the same text into the Webhook "Verify token" box in Meta.
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_text
WHATSAPP_GRAPH_API_VERSION=v23.0

# --- AI model (REQUIRED: the key for the model you choose) ---
# Gemini: LLM_MODEL=gemini/gemini-2.5-flash with GEMINI_API_KEY from aistudio.google.com (starts with AIza)
# OpenAI: LLM_MODEL=openai/gpt-4o-mini with OPENAI_API_KEY
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=AIza_your_gemini_key_here
OPENAI_API_KEY=

# --- Google Calendar bookings & SEO report (optional) ---
# Put the service account key file at config/google-service-account.json (never committed).
# Optional API key for Google's website check (PageSpeed Insights); works without one at low volume.
PAGESPEED_API_KEY=

# --- Platform admin (optional) ---
# WhatsApp numbers that may manage businesses by message ("admin help"). Comma-separated, with +.
PLATFORM_ADMIN_PHONES=+971500000000

# --- Business list (optional) ---
# Put real businesses and phone numbers in config/tenants.local.yaml (never committed) and set:
TENANTS_FILE=tenants.local.yaml

# --- Alert emails (REQUIRED) ---
# Where alerts go (monthly spend notices, failed backups).
ALERT_EMAIL=you@example.com
# Account used to send them. For Gmail, create an "App password" (Google Account > Security >
# 2-Step Verification > App passwords) and use it as SMTP_PASSWORD.
SMTP_USER=sender@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional "From" address; defaults to SMTP_USER.
ALERT_FROM_EMAIL=

# --- Optional extra alert channel ---
PLATFORM_ALERT_WHATSAPP=

# --- Stripe billing (optional; not used during the free pilot) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Daily off-server backups (used by scripts/backup.sh) ---
# Long random passphrase; store a copy somewhere safe OFF the server, without it backups cannot be restored.
BACKUP_PASSPHRASE=change_me_to_a_long_random_passphrase
# rclone destination, e.g. gdrive:assistant-backups or offsite-sftp:/backups
BACKUP_REMOTE=myremote:assistant-backups
BACKUP_LOCAL_DIR=/var/backups/agentic-sme
BACKUP_LOCAL_KEEP_DAYS=14

# --- Local development only (docker-compose sets these inside the container) ---
TENANTS_CONFIG_PATH=config/tenants.yaml
TENANTS_DATA_DIR=data/tenants
